# ─── Build outputs ──────────────────────────────────────────────────────────
# release binaries built by ./build_release.sh — huge and reproducible
export/

# C# / .NET build artefacts
[Bb]in/
[Oo]bj/
publish/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
*.userosscache
*.sln.docstates
*.binlog

# NuGet
*.nupkg
*.snupkg
project.lock.json
packages/

# Go build artefacts
# the launcher binary that ./build.sh drops next to main.go
/ui/patchersource/patcher
/ui/patchersource/patcher.exe
# the C# patcher exe copied in by build.sh for //go:embed
/ui/patchersource/osu_patcher.exe
# Go test/cover/profile outputs
*.test
*.out
*.prof

# ─── Runtime / user-local state ─────────────────────────────────────────────
# legacy paths — the app now uses ~/.config/osu-patcher, but pre-migration
# binaries dropped these next to themselves. Never commit personal config.
/ui/patchersource/settings.json
settings.local.json

# live working copy of whichever theme the user has applied
/ui/patchersource/themes/ActiveTheme/

# patcher run-time logs
patcher_log.txt
patcher_crash.log

# wine / osu side-effects that can land in cwd
/server.txt
/client.txt

# ─── Editors / IDEs ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code per-project state (local-only)
.claude/

# ─── OS junk ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Stale local backups the user occasionally drops in ─────────────────────
oldprogram.cs
oldreadme.md
